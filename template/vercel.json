{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "bash scripts/migrate.sh && npx expo export --platform web && npx tsx scripts/seo.ts",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/go/:channel",
      "destination": "/api/go?channel=:channel"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
