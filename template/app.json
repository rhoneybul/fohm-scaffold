{
  "expo": {
    "name": "Starter",
    "slug": "starter",
    "scheme": "starter",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon/icon.png",
    "ios": {
      "bundleIdentifier": "com.example.starter",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.starter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-icon.png",
        "monochromeImage": "./assets/icon/adaptive-icon-monochrome.png",
        "backgroundImage": "./assets/icon/adaptive-icon-background.png",
        "backgroundColor": "#111113"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Starter",
      "shortName": "Starter",
      "themeColor": "#F7F5F0",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/splash.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#111113",
          "dark": {
            "image": "./assets/icon/splash.png",
            "backgroundColor": "#111113"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose videos and photos to send to your coach.",
          "cameraPermission": "Record videos to send to your coach.",
          "microphonePermission": "Record sound with your videos."
        }
      ],
      "expo-video",
      "expo-apple-authentication",
      "./plugins/withTappStaticFrameworks",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://jitpack.io"
            ],
            "extraProguardRules": "-keep class com.example.tapp.** { *; }\n-keep class com.comtappsosdk.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://starter.example.com"
    }
  }
}
