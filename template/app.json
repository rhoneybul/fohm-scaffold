{
  "expo": {
    "name": "Starter",
    "slug": "starter",
    "scheme": "starter",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.example.starter",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.starter"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Starter",
      "shortName": "Starter",
      "themeColor": "#F7F5F0"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose videos and photos to send to your coach.",
          "cameraPermission": "Record videos to send to your coach.",
          "microphonePermission": "Record sound with your videos."
        }
      ],
      "expo-video",
      "./plugins/withTappStaticFrameworks",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://jitpack.io"
            ],
            "extraProguardRules": "-keep class com.example.tapp.** { *; }\n-keep class com.comtappsosdk.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://starter.example.com"
    }
  }
}
