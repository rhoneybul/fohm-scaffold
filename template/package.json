{
  "name": "starter",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "build:web": "expo export --platform web && tsx scripts/seo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:smoke": "node --import tsx --test tests/smoke/*.test.ts",
    "migrate": "bash scripts/migrate.sh",
    "serve:local": "expo export --platform web && tsx scripts/seo.ts && tsx scripts/serve-local.ts",
    "og": "tsx scripts/og-image.ts",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "screens": "node scripts/screens.mjs",
    "brand": "tsx scripts/brand-assets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "com-tapp-so-sdk": "2.0.1",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.14",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "supabase": "3.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
