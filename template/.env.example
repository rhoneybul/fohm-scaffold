# Every variable the server reads. Set them in Vercel (Settings → Environment
# Variables, Production), never in the app: the app reads what it needs from
# /api/health. Each integration is off until its variables are set. Mark
# secrets Sensitive. `npx github:rhoneybul/fohm-scaffold status` walks you through each.

# Database and login (Supabase): required for real accounts
SUPABASE_DB_URL=            # Session pooler string, port 5432 (Sensitive)
SUPABASE_PUBLISHABLE_KEY=   # public
# SUPABASE_URL=             # optional: worked out from SUPABASE_DB_URL
OWNER_CODE=                 # the code that makes an owner account (Sensitive)
COACH_CODE=                 # the code that makes a coach account, if you have coaches (Sensitive)
# SITE_URL=https://your.domain   # links in emails; Vercel's production URL otherwise

# Payments for Pro (Stripe)
STRIPE_SECRET_KEY=          # Sensitive
STRIPE_WEBHOOK_SECRET=      # Sensitive; webhook to https://your.domain/api/stripe-webhook
# STRIPE_PRICE_ID=          # use a price made in Stripe; otherwise one is made from these:
# PRO_PRICE_CENTS=1000
# STRIPE_CURRENCY=usd

# Product analytics (PostHog)
POSTHOG_KEY=                # project API key (public by design)
# POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com

# Error reports (Sentry)
SENTRY_DSN=                 # public by design

# Email (Resend)
RESEND_API_KEY=             # Sensitive
EMAIL_FROM=                 # e.g. "Your App <hello@your.domain>" on a domain verified in Resend

# AI assistant (Claude)
ANTHROPIC_API_KEY=          # Sensitive
# AI_DAILY_LIMIT=30
# AI_SYSTEM_PROMPT=

# Push notifications (Expo): no key needed. Only if you turn on enhanced push security in Expo:
# EXPO_ACCESS_TOKEN=
